import numpy as np
import pandas as pd
from sklearn.ensemble import IsolationForest
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import classification_report

# -------------------------------------------------------------
# 1. SIMULATE NETWORK TRAFFIC DATA
# -------------------------------------------------------------
print("🔹 Generating simulated network traffic data...")
np.random.seed(42)

# Normal Traffic Baseline (Low packet size, low duration, stable rates)
normal_traffic = np.random.normal(loc=[50, 0.5, 10], scale=[10, 0.1, 2], size=(1000, 3))

# Malicious Traffic / Anomalies (e.g., Exfiltration, Port Scanning, DDoS)
# Anomalies will have abnormally high packet counts, long durations, or rapid rates
attack_traffic = np.random.uniform(low=[200, 5.0, 50], high=[1000, 20.0, 500], size=(50, 3))

# Combine into dataframes
columns = ['packet_count', 'duration_seconds', 'request_rate_per_sec']
df_normal = pd.DataFrame(normal_traffic, columns=columns)
df_attack = pd.DataFrame(attack_traffic, columns=columns)

# Assign ground truth labels for evaluation (1 for normal, -1 for anomaly)
df_normal['actual_status'] = 1
df_attack['actual_status'] = -1
df_all = pd.concat([df_normal, df_attack]).reset_index(drop=True)

# Separate features from labels
X = df_all[columns]
y_true = df_all['actual_status']

# -------------------------------------------------------------
# 2. FEATURE SCALING
# -------------------------------------------------------------
# Machine learning algorithms perform better when features are scaled evenly
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# -------------------------------------------------------------
# 3. TRAIN AI ANOMALY DETECTION MODEL
# -------------------------------------------------------------
print("🤖 Training Isolation Forest AI Model...")
# contamination = expected proportion of outliers/malicious traffic in the data (approx 5%)
model = IsolationForest(contamination=0.05, random_state=42)
model.fit(X_scaled)

# -------------------------------------------------------------
# 4. PREDICT THREATS
# -------------------------------------------------------------
# The model returns 1 for normal data points and -1 for suspected anomalies
df_all['ai_prediction'] = model.predict(X_scaled)

# -------------------------------------------------------------
# 5. CYBERSECURITY ALERTS & EVALUATION
# -------------------------------------------------------------
print("\n🚨 SECURITY SIEM ALERTS GENERATED BY AI:")
flagged_threats = df_all[df_all['ai_prediction'] == -1]

# Display the first 5 threats flagged by the AI
print(flagged_threats[['packet_count', 'duration_seconds', 'request_rate_per_sec']].head())

print(f"\nTotal Network Traffic Analyzed: {len(df_all)}")
print(f"Total Security Alerts Triaged by AI: {len(flagged_threats)}")

print("\n📈 AI Model Performance Matrix:")
print(classification_report(y_true, df_all['ai_prediction'], target_names=['Malicious', 'Normal']))
